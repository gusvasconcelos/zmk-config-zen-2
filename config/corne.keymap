#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUN  4
#define SYS  5

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | NONE |
            // | NONE | A/GUI | R/ALT | S/CTRL| T/SFT |  G  |   |  M  | N/SFT| E/CTRL| I/ALT | O/GUI | NONE |
            // | NONE |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | NONE |
            //                    | SYS/ESC | NAV/TAB | SPACE |   | RET | NUM/BSPC | SYM/DEL |

            bindings = <
&none  &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J        &kp L        &kp U        &kp Y       &kp SQT     &none
&none  &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G          &kp M        &hm RSHFT N  &hm RCTRL E  &hm RALT I  &hm RGUI O  &none
&none  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K        &kp H        &kp COMMA    &kp DOT     &kp FSLH    &none
                               &lt 3 ESC    &lt NAV TAB  &lt 2 SPACE    &lt 5 ENTER  &lt 4 BSPC   &kp DELETE
            >;
        };

        nav_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE |     |     |     |     |     |   | REDO| PASTE| COPY| CUT | UNDO| NONE |
            // | NONE | GUI | ALT | CTRL| SHFT|     |   | LEFT| DOWN |  UP | RGHT| CAPS| NONE |
            // | NONE |     |     |     |     |     |   | INS | HOME | PGDN| PGUP| END | NONE |
            //                    |     |     |     |   | RET | BSPC | DEL |

            bindings = <
&none  &trans    &trans    &trans     &trans     &trans    &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp CAPS   &none
&none  &trans    &trans    &trans     &trans     &trans    &kp INS    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                           &trans     &trans     &trans    &kp RET    &kp BSPC   &kp DEL
            >;
        };

        num_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE |  [  |  7  |  8  |  9  |  ]  |   |     |     |     |     |     | NONE |
            // | NONE |  ;  |  4  |  5  |  6  |  =  |   |     | SHFT| CTRL| ALT | GUI | NONE |
            // | NONE |  `  |  1  |  2  |  3  |  \  |   |     |     |     |     |     | NONE |
            //                    |  .  |  0  |  -  |   |     |     |     |

            bindings = <
&none  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &none
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &none
                          &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };

        sym_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE |  `  |  <  |  >  |  -  |  |  |   |  ^  |  {  |  }  |  $  |  -> | NONE |
            // | NONE |  !  |  *  |  /  |  =  |  &  |   |  #  |  (  |  )  |  ;  |  "  | NONE |
            // | NONE |  ~  |  +  |  [  |  ]  |  %  |   |  @  |  :  |  ,  |  .  |  '  | NONE |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&none  &kp GRAVE  &kp LT     &kp GT    &kp MINUS  &kp PIPE     &kp CARET  &kp LBRC   &kp RBRC   &kp DLLR  &m_arrow  &none
&none  &kp EXCL   &kp ASTRK  &kp FSLH  &kp EQUAL  &kp AMPS     &kp HASH   &kp LPAR   &kp RPAR   &kp SEMI  &kp DQT   &none
&none  &kp TILDE  &kp PLUS   &kp LBKT  &kp RBKT   &kp PRCNT    &kp AT     &kp COLON  &kp COMMA  &kp DOT   &kp SQT   &none
                             &trans    &trans     &trans       &trans     &trans     &trans
            >;
        };

        fun_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE | F12 |  F7 |  F8 |  F9 | PRSC|   |     |     |     |     |     | NONE |
            // | NONE | F11 |  F4 |  F5 |  F6 | SLCK|   |     | SHFT| CTRL| ALT | GUI | NONE |
            // | NONE | F10 |  F1 |  F2 |  F3 | PAUS|   |     |     |     |     |     | NONE |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN          &trans  &trans     &trans     &trans    &trans    &none
&none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &trans  &trans     &trans     &trans    &trans    &none
                        &trans  &trans  &trans             &trans  &trans     &trans
            >;
        };

        sys_layer {
            // -----------------------------------------------------------------------------------------
            // | NONE |     |     |     |     |     |   |BT CLR| BT 0| BT 1| BT 2| BT 3| NONE |
            // | NONE | GUI | ALT | CTRL| SHFT|     |   | MUTE | VOL-| VOL+| PREV| NEXT| NONE |
            // | NONE |     |     |     |     |     |   |      |     |     |     | PLAY| NONE |
            //                    |     |     |     |   |      |     |     |

            bindings = <
&none  &trans    &trans    &trans     &trans     &trans    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV    &kp C_NEXT    &none
&none  &trans    &trans    &trans     &trans     &trans    &trans      &trans        &trans        &trans        &kp C_PP      &none
                           &trans     &trans     &trans    &trans      &trans        &trans
            >;
        };
    };
};
